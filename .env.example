# Copy to .env and fill in. Never commit .env.
# In GitHub Actions these come from repo secrets instead.

# Required for a real search run
FIRECRAWL_API_KEY=

# Runner safety (dry run unless CONFIRM_SPEND=1)
CONFIRM_SPEND=0
MAX_QUERIES=8
LIMIT=20

# Optional: file with companies you already have (any myworkdayjobs URLs in it are used to dedupe)
MASTER_LIST=

# Optional: push net-new companies into a Clay table
CLAY_WEBHOOK_URL=
CLAY_WEBHOOK_AUTH=
# Optional: Clay tables to dedupe against via the clay CLI, "tableId:companyColumnId ..."
CLAY_DEDUP_TABLES=

# Notion (dedupe + daily digest)
NOTION_API_TOKEN=
COMPANY_DB_ID=
MNC_DB_ID=

# Slack digests
SLACK_WEBHOOK_URL=
